# Zkopíruj na server jako deploy/.env a uprav podle svého hardwaru.

# HTTP port webového rozhraní
PORT=8080

# --- Audio výstup (ALSA) ---
MPV_AO=alsa
# ALSA zařízení jacku. Zjisti přes `aplay -l` na hostiteli.
# Příklady: alsa/plughw:0,0  nebo  alsa/hw:CARD=PCH,DEV=0
# Prázdné = default výstup.
MPV_AUDIO_DEVICE=

# --- Přehrávání ---
DEFAULT_VOLUME=100
RADIO_REFILL_THRESHOLD=3

# --- Cesty k přihlášení (uvnitř kontejneru; měnit netřeba) ---
# YTMUSIC_AUTH=/config/browser.json
# YTDLP_COOKIES=/config/cookies.txt
