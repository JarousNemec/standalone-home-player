# Zkopíruj na server jako deploy/.env a uprav podle svého hardwaru.

# HTTP port webového rozhraní
PORT=8080

# --- Audio výstup (ALSA) ---
MPV_AO=alsa
# ZDE DOPLŇ své zařízení. Zjistíš přes `aplay -l` na serveru.
# Příklady: alsa/plughw:0,0  nebo  alsa/hw:CARD=PCH,DEV=0
# Prázdné = mpv zvolí default výstup (často stačí).
MPV_AUDIO_DEVICE=

# --- Přehrávání ---
# Výchozí hlasitost 0-100
DEFAULT_VOLUME=100
# Kolik skladeb před koncem fronty spustit doplnění rádia (autoplay)
RADIO_REFILL_THRESHOLD=3

# --- Jazyk a region dat z YouTube Music ---
YTM_LANGUAGE=cs
YTM_LOCATION=CZ

# --- Přihlášení ---
# Jediný soubor, který sem patří ručně: deploy/config/browser.json
YTMUSIC_AUTH=/config/browser.json
# Cookies pro yt-dlp se GENERUJÍ z browser.json, ručně je neexportuj.
# Cesta musí zůstat na tmpfs (RAM): yt-dlp si soubor po každé skladbě ukládá
# zpátky, takže v /config by to znamenalo zápis do flash při každé písničce.
YTDLP_COOKIES=/dev/shm/yt-cookies.txt

# --- Obnovování session ---
# Session tokeny YouTube rotují; aplikace si o nové říká sama jako prohlížeč,
# takže jeden export hlaviček vydrží měsíce. Vypnout jen při ladění.
SESSION_ROTATE=1
# Jak často jen OVĚŘIT, že session žije. Pouze síťový dotaz, disku se netýká.
SESSION_CHECK_INTERVAL=540
# Strop stáří tokenu v sekundách. Rotace je jediný okamžik, kdy se zapisuje na
# disk, takže tahle hodnota určuje počet zápisů: 24 h / hodnota.
# Při 7200 s (2 h) to je 12 zápisů denně. Změřeno: nerotovaný token byl živý
# i po 3 h 10 min, strop je proto s rezervou pod tím.
# 0 = rotovat výhradně při selhání ověření (nejméně zápisů, ale víc rizika).
SESSION_MAX_TOKEN_AGE=7200
