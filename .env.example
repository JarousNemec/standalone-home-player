# === Zkopíruj do .env a uprav podle svého serveru ===

# HTTP port webového rozhraní
PORT=8080

# --- Přihlášení k YouTube Music (viz README) ---
# Cesta k ytmusicapi auth souboru (hlavičky z prohlížeče)
YTMUSIC_AUTH=/config/browser.json
# Kam se GENERUJE cookie soubor pro yt-dlp (Premium kvalita). Vyrábí se
# z browser.json, ručně ho exportovat nemusíš. Nech ho na tmpfs (/dev/shm) —
# yt-dlp do něj po každé skladbě zapisuje a na disku by to zbytečně opotřebovávalo
# flash. Prázdná hodnota = bez cookies (nižší kvalita).
YTDLP_COOKIES=/dev/shm/yt-cookies.txt

# --- Obnovování session ---
# Session tokeny YouTube rotují; aplikace si o nové říká sama jako prohlížeč,
# díky tomu vydrží jeden export hlaviček měsíce.
# Vypnout jen při ladění: SESSION_ROTATE=0
SESSION_ROTATE=1
# Jak často ověřit, že session žije (sekundy). Jen dotaz po síti, na disk nesahá.
SESSION_CHECK_INTERVAL=540
# Strop stáří tokenu (sekundy). Rotace se jinak spustí až když ověření selže —
# a rotace je JEDINÝ okamžik, kdy se zapisuje na disk. Nižší hodnota = víc
# zápisů (24 h / tato hodnota), vyšší = starší klíč na disku.
# 0 = žádný strop, rotovat výhradně při selhání ověření.
SESSION_MAX_TOKEN_AGE=7200

# --- Jazyk a region dat z YouTube Music ---
# Ovlivňuje názvy sekcí na Domů, kategorie hledání a žebříčky.
# Podporované jazyky: ar cs de en es fr hi it ja ko nl pt ru tr ur zh_CN zh_TW
YTM_LANGUAGE=cs
YTM_LOCATION=CZ
