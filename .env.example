# === Zkopíruj do .env a uprav podle svého serveru ===

# HTTP port webového rozhraní
PORT=8080

# --- Přihlášení k YouTube Music (viz README) ---
# Cesta k ytmusicapi auth souboru (hlavičky z prohlížeče)
YTMUSIC_AUTH=/config/browser.json
# Cesta k yt-dlp cookies (Premium kvalita); nech prázdné pro anonymní režim
YTDLP_COOKIES=/config/cookies.txt

# --- Audio výstup (ALSA) ---
# Audio output driver mpv: "alsa" na serveru, "null" pro vývoj bez zvuku
MPV_AO=alsa
# ALSA zařízení jacku. Zjistíš přes `aplay -l` na hostiteli.
# Příklady: "alsa/plughw:0,0"  nebo  "alsa/hw:CARD=PCH,DEV=0"
# Nech prázdné pro automatickou volbu (default výstup).
MPV_AUDIO_DEVICE=

# --- Přehrávání ---
# Výchozí hlasitost 0-100
DEFAULT_VOLUME=100
# Kolik skladeb před koncem fronty spustit doplnění rádia (autoplay)
RADIO_REFILL_THRESHOLD=3
